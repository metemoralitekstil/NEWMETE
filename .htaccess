RewriteEngine On

# HTTP -> HTTPS & non-WWW -> WWW 301 Redirect (Google SEO)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.mete-morali.com/$1 [R=301,L]

# Redirect old URLs (/urunlerimiz, /shop, /hakkimizda, /isci-elbisesi-kaban, eski urun sayfaları) to active pages
RewriteRule ^urunlerimiz(/.*|\.html)?$ /katalog [R=301,L]
RewriteRule ^shop(/.*|\.html)?$ /katalog [R=301,L]
RewriteRule ^hakkimizda(/.*|\.html)?$ / [R=301,L]
RewriteRule ^about(/.*|\.html)?$ / [R=301,L]
RewriteRule ^isci-elbisesi-kaban(/.*|\.html)?$ /katalog [R=301,L]
RewriteRule ^kislik_parka(/.*|\.html)?$ /urun-detay?id=1 [R=301,L]
RewriteRule ^supervisorkiyafet(/.*|\.html)?$ /urun-detay?id=2 [R=301,L]
RewriteRule ^hi-vis_kaynakcikiyafeti(/.*|\.html)?$ /urun-detay?id=3 [R=301,L]
RewriteRule ^mavikaynakcikiyafeti(/.*|\.html)?$ /urun-detay?id=4 [R=301,L]

# Redirect /anasayfa or /anasayfa.html to / (clean domain)
RewriteRule ^anasayfa(\.html)?$ / [R=301,L]

# Redirect /index or /index.html to / (clean domain)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.html)?\ HTTP/
RewriteRule ^index(\.html)?$ / [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*([^.]+)\.html\ HTTP/
RewriteRule ^(([^/]+/)*([^.]+))\.html$ /$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# ==============================================================================
# GZIP / BROTLI SIKIŞTIRMA (COMPRESSION)
# ==============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml font/ttf font/otf application/font-woff application/font-woff2
</IfModule>

# ==============================================================================
# TARAYICI ÖNBELLEKLEME (BROWSER CACHING / EXPIRES HEADERS)
# ==============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Görseller (WebP, PNG, JPG, SVG, ICO)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fontlar
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
</IfModule>

# ==============================================================================
# CACHE-CONTROL HEADERS
# ==============================================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|png|jpg|jpeg|svg|gif|ico|woff|woff2|ttf|otf)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
